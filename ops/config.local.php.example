/**
 * Production-oriented local overrides for a private app container.
 *
 * Copy to your deployment host outside the image, then run backups and the app
 * against the same runtime paths declared here so operational tooling can
 * verify it is protecting the intended state.
 */

define('APP_RUNTIME_DIR', '/srv/cloaking/runtime');
define('DB_PATH', '/srv/cloaking/runtime/cloaking.sqlite');
define('LOG_PATH', '/srv/cloaking/runtime/logs/');
define('APP_BASE_URL', 'https://app.example.com');
define('SYSTEM_HOSTS', [
    'app.example.com',
]);
define('TRUSTED_PROXIES', [
    '172.23.0.2/32',
]);
