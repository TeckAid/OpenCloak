# Cloaking SaaS - Apache configuration
Options -Indexes
DirectoryIndex index.php

<IfModule mod_authz_core.c>
    <FilesMatch "^(?:config(?:\.local(?:\.example)?)?\.php|install\.php|dev-router\.php|Dockerfile|docker-compose\.yml|nginx\.conf|\.dockerignore|README\.md|CODE_REVIEW\.md|IMPLEMENTATION_PLAN\.md)$">
        Require all denied
    </FilesMatch>
</IfModule>

RewriteEngine On

# ---- Dotfile probes (.env, .git/config, ...) → 404, before any routing ------
# Any path segment beginning with a dot is rejected outright so scanner traffic
# never reaches PHP. well-known is excepted for ACME/other standard challenges.
RewriteRule (?:^|/)\.(?!well-known/)[^/]* - [R=404,L,NC]

# ---- Deny sensitive paths (first!) ------------------------------------------
RewriteRule ^(?:data|logs|includes|docs|docker|tests|\.git|\.github|\.superpowers)(?:/|$) - [F,L,NC]
RewriteRule ^.+\.(?:sqlite(?:-(?:wal|shm|journal))?|sqlite3|db3?|sql|log)$ - [F,L,NC]

# ---- Admin panel --------------------------------------------------------------
RewriteRule ^admin/?$ /admin/index.php [L]

# ---- API ------------------------------------------------------------------------
# Guard with !-f so the rewrite target (/api/index.php, itself a real file) is
# not re-matched on the per-directory rewrite pass, which otherwise loops until
# Apache aborts with "exceeded the limit of 10 internal redirects" (HTTP 500).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(/.*)?$ /api/index.php [L]

# ---- Static assets (pass through) ------------------------------------------------
RewriteRule ^assets(/.*)?$ - [L]

# ---- Cloaked links (single slug segment) ------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ /index.php [QSA,L]

# ---- Caching -----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>
